{
  "locomo": {
    "plugin": "locomo-dataset",
    "parameters": {
      "path": "data/locomo.json",
      "utc_offset_minutes": 0
    }
  },
  "longmemeval": {
    "plugin": "longmemeval-dataset",
    "parameters": {
      "path": "data/longmemeval.json",
      "utc_offset_minutes": 0
    }
  },
  "personamem-v1": {
    "plugin": "personamem-dataset",
    "parameters": {
      "path": "data/questions.csv",
      "contexts_path": "data/contexts.jsonl"
    }
  },
  "m3-robot": {
    "plugin": "m3-dataset",
    "parameters": {
      "path": "data/robot.json",
      "variant": "robot",
      "sample_ids": [
        "video-id"
      ],
      "memory_loaders": {
        "video-id": {
          "plugin": "m3",
          "parameters": {
            "path": "data/video-id.pkl"
          }
        }
      }
    }
  },
  "m3-web": {
    "plugin": "m3-dataset",
    "parameters": {
      "path": "data/web.json",
      "variant": "web",
      "sample_ids": [
        "video-id"
      ],
      "memory_loaders": {
        "video-id": {
          "plugin": "m3",
          "parameters": {
            "path": "data/video-id.pkl"
          }
        }
      }
    }
  }
}
