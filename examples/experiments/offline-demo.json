{
  "dataset": {"plugin": "locomo-dataset", "parameters": {"path": "tiny_locomo.json"}},
  "initializer": {"plugin": "history-initializer"},
  "compression": {
    "planner": {"plugin": "random-merge"},
    "operator": {"plugin": "text-operator", "parameters": {"writer": {"plugin": "concat-writer"}}},
    "wrapper": {"plugin": "memos-wrapper", "parameters": {"output_dir": "unused"}}
  },
  "reader": {"plugin": "retrieval-reader", "parameters": {"answerer": {"plugin": "context-echo-answerer"}}},
  "evaluator": {"plugin": "metric-evaluator"},
  "capture": {"profile": "cases", "text_policy": "omit"},
  "observers": [{"plugin": "event-report-observer", "required": true}],
  "output_dir": "../../build/experiments/offline-demo",
  "run": {"seed": 7, "evaluate_source": true, "budgets": [{"unit": "nodes", "ratio": 0.5}]}
}
