{
  "planner": {
    "plugin": "memforest",
    "parameters": {
      "allocator": {
        "plugin": "legacy-cluster-ceil",
        "parameters": {
          "keep_ratio": 0.7
        }
      }
    }
  },
  "operator": {
    "plugin": "memforest-operator"
  },
  "features": [
    {
      "plugin": "event-time-features",
      "parameters": {
        "aggregation": "latest"
      }
    }
  ]
}
