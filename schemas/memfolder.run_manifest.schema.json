{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Structural schema. Semantic invariants are enforced by memfolder.core.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "data"
  ],
  "properties": {
    "schema_id": {
      "const": "memfolder.run_manifest"
    },
    "schema_version": {
      "const": 1
    },
    "data": {
      "$ref": "#/$defs/memfolder.run_manifest"
    }
  },
  "$defs": {
    "memfolder.run_manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string"
        },
        "config_fingerprint": {
          "type": "string"
        },
        "samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.sample_ref"
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.plugin_binding"
          }
        },
        "seed": {
          "type": "integer"
        },
        "mode": {
          "enum": [
            "once",
            "repeat",
            "stream"
          ]
        },
        "compression_status": {
          "enum": [
            "pending",
            "running",
            "completed",
            "failed"
          ]
        },
        "evaluation_status": {
          "enum": [
            "pending",
            "running",
            "completed",
            "not_run",
            "failed"
          ]
        },
        "observation_status": {
          "enum": [
            "off",
            "recording",
            "complete",
            "incomplete",
            "failed"
          ]
        },
        "coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/memfolder.trace_coverage"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.artifact_ref"
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      },
      "required": [
        "run_id",
        "config_fingerprint",
        "samples",
        "bindings",
        "seed",
        "mode",
        "compression_status",
        "evaluation_status",
        "observation_status"
      ]
    },
    "memfolder.sample_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "type": "string"
        },
        "sample_id": {
          "type": "string"
        },
        "split": {
          "type": "string"
        },
        "dataset_fingerprint": {
          "type": "string"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      },
      "required": [
        "dataset_id",
        "sample_id",
        "split",
        "dataset_fingerprint"
      ]
    },
    "memfolder.plugin_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plugin_id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "api_version": {
          "type": "integer"
        },
        "implementation_revision": {
          "type": "string"
        },
        "parameters_fingerprint": {
          "type": "string"
        }
      },
      "required": [
        "plugin_id",
        "role",
        "api_version",
        "implementation_revision",
        "parameters_fingerprint"
      ]
    },
    "memfolder.trace_coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capture": {
          "$ref": "#/$defs/memfolder.capture_policy"
        },
        "complete_for_capture": {
          "type": "boolean"
        },
        "events_written": {
          "type": "integer"
        },
        "events_dropped": {
          "type": "integer"
        },
        "missing_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_stages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "capture",
        "complete_for_capture"
      ]
    },
    "memfolder.capture_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "enum": [
            "off",
            "summary",
            "cases",
            "full"
          ]
        },
        "sample_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.scope"
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diagnostic_schemas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "text_policy": {
          "enum": [
            "omit",
            "redacted",
            "selected",
            "full"
          ]
        },
        "vector_policy": {
          "enum": [
            "omit",
            "metadata",
            "selected",
            "full"
          ]
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      },
      "required": []
    },
    "memfolder.scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "type": "string"
        },
        "sample_id": {
          "type": "string"
        },
        "partition_id": {
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "sample_id",
        "partition_id"
      ]
    },
    "memfolder.artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "schema_id": {
          "type": "string"
        },
        "record_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "media_type"
      ]
    },
    "JSONValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      ]
    }
  }
}
