{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Structural schema. Semantic invariants are enforced by memfolder.core.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "data"
  ],
  "properties": {
    "schema_id": {
      "const": "memfolder.retention"
    },
    "schema_version": {
      "const": 1
    },
    "data": {
      "$ref": "#/$defs/memfolder.retention"
    }
  },
  "$defs": {
    "memfolder.retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "may_drop": {
          "type": "boolean"
        },
        "may_merge": {
          "type": "boolean"
        },
        "may_rewrite": {
          "type": "boolean"
        }
      },
      "required": []
    },
    "JSONValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      ]
    }
  }
}
