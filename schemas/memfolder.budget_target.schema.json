{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Structural schema. Semantic invariants are enforced by memfolder.core.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "data"
  ],
  "properties": {
    "schema_id": {
      "const": "memfolder.budget_target"
    },
    "schema_version": {
      "const": 1
    },
    "data": {
      "$ref": "#/$defs/memfolder.budget_target"
    }
  },
  "$defs": {
    "memfolder.budget_target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "group": {
          "$ref": "#/$defs/memfolder.budget_group"
        },
        "input_amount": {
          "type": "integer"
        },
        "limit": {
          "type": "integer"
        }
      },
      "required": [
        "group",
        "input_amount",
        "limit"
      ]
    },
    "memfolder.budget_group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "type": "string"
        },
        "member_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "group_id",
        "member_ids"
      ]
    },
    "JSONValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      ]
    }
  }
}
