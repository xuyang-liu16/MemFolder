{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Structural schema. Semantic invariants are enforced by memfolder.core.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "data"
  ],
  "properties": {
    "schema_id": {
      "const": "memfolder.algorithm_state"
    },
    "schema_version": {
      "const": 1
    },
    "data": {
      "$ref": "#/$defs/memfolder.algorithm_state"
    }
  },
  "$defs": {
    "memfolder.algorithm_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "data": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.artifact_ref"
          }
        }
      },
      "required": [
        "schema",
        "version"
      ]
    },
    "memfolder.artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "schema_id": {
          "type": "string"
        },
        "record_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "media_type"
      ]
    },
    "JSONValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      ]
    }
  }
}
