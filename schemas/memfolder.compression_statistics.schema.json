{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Structural schema. Semantic invariants are enforced by memfolder.core.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "data"
  ],
  "properties": {
    "schema_id": {
      "const": "memfolder.compression_statistics"
    },
    "schema_version": {
      "const": 1
    },
    "data": {
      "$ref": "#/$defs/memfolder.compression_statistics"
    }
  },
  "$defs": {
    "memfolder.compression_statistics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_nodes": {
          "type": "integer"
        },
        "output_nodes": {
          "type": "integer"
        },
        "input_eligible": {
          "type": "integer"
        },
        "output_eligible": {
          "type": "integer"
        },
        "input_characters": {
          "type": "integer"
        },
        "output_characters": {
          "type": "integer"
        },
        "input_edges": {
          "type": "integer"
        },
        "output_edges": {
          "type": "integer"
        },
        "rounds": {
          "type": "integer"
        },
        "elapsed_seconds": {
          "type": "number"
        },
        "node_retention": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "character_retention": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "measurement": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      },
      "required": [
        "input_nodes",
        "output_nodes",
        "input_eligible",
        "output_eligible",
        "input_characters",
        "output_characters",
        "input_edges",
        "output_edges",
        "rounds",
        "elapsed_seconds",
        "node_retention",
        "character_retention"
      ]
    },
    "JSONValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      ]
    }
  }
}
