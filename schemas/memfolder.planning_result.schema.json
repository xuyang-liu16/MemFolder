{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Structural schema. Semantic invariants are enforced by memfolder.core.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "data"
  ],
  "properties": {
    "schema_id": {
      "const": "memfolder.planning_result"
    },
    "schema_version": {
      "const": 1
    },
    "data": {
      "$ref": "#/$defs/memfolder.planning_result"
    }
  },
  "$defs": {
    "memfolder.planning_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan": {
          "$ref": "#/$defs/memfolder.action_plan"
        },
        "next_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/memfolder.algorithm_state"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.artifact_ref"
          }
        }
      },
      "required": [
        "plan"
      ]
    },
    "memfolder.action_plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "type": "string"
        },
        "input_fingerprint": {
          "type": "string"
        },
        "target_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.action"
          }
        },
        "boundary": {
          "type": "string"
        },
        "state_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/memfolder.artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostic_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.artifact_ref"
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      },
      "required": [
        "plan_id",
        "input_fingerprint",
        "target_ids",
        "actions"
      ]
    },
    "memfolder.action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "member_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_view": {
          "type": "string"
        },
        "output_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/memfolder.scope"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diagnostic_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.artifact_ref"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      },
      "required": [
        "action_id",
        "kind",
        "member_ids"
      ]
    },
    "memfolder.scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "type": "string"
        },
        "sample_id": {
          "type": "string"
        },
        "partition_id": {
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "sample_id",
        "partition_id"
      ]
    },
    "memfolder.artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "schema_id": {
          "type": "string"
        },
        "record_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "media_type"
      ]
    },
    "memfolder.algorithm_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "data": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.artifact_ref"
          }
        }
      },
      "required": [
        "schema",
        "version"
      ]
    },
    "JSONValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      ]
    }
  }
}
