{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Structural schema. Semantic invariants are enforced by memfolder.core.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "data"
  ],
  "properties": {
    "schema_id": {
      "const": "memfolder.action_rule"
    },
    "schema_version": {
      "const": 1
    },
    "data": {
      "$ref": "#/$defs/memfolder.action_rule"
    }
  },
  "$defs": {
    "memfolder.action_rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_members": {
          "type": "integer"
        },
        "max_members": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "min_outputs": {
          "type": "integer"
        },
        "max_outputs": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserves_records": {
          "type": "boolean"
        },
        "conserves_lineage": {
          "type": "boolean"
        }
      },
      "required": [
        "min_members",
        "max_members",
        "min_outputs",
        "max_outputs"
      ]
    },
    "JSONValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      ]
    }
  }
}
