{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Structural schema. Semantic invariants are enforced by memfolder.core.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "data"
  ],
  "properties": {
    "schema_id": {
      "const": "memfolder.loading.source"
    },
    "schema_version": {
      "const": 1
    },
    "data": {
      "$ref": "#/$defs/memfolder.loading.source"
    }
  },
  "$defs": {
    "memfolder.loading.source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string"
        },
        "framework": {
          "type": "string"
        },
        "format_id": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "records_read": {
          "type": "integer"
        },
        "edges_read": {
          "type": "integer"
        },
        "coverage": {
          "enum": [
            "declared_complete",
            "partial",
            "unknown"
          ]
        },
        "consistency": {
          "enum": [
            "file",
            "best_effort",
            "caller_snapshot"
          ]
        }
      },
      "required": [
        "source_id",
        "framework",
        "format_id",
        "sha256",
        "records_read",
        "edges_read"
      ]
    },
    "JSONValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      ]
    }
  }
}
