{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Structural schema. Semantic invariants are enforced by memfolder.core.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "data"
  ],
  "properties": {
    "schema_id": {
      "const": "memfolder.planning_request"
    },
    "schema_version": {
      "const": 1
    },
    "data": {
      "$ref": "#/$defs/memfolder.planning_request"
    }
  },
  "$defs": {
    "memfolder.planning_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/$defs/memfolder.snapshot"
        },
        "budgets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.resolved_budget"
          }
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.feature_batch"
          }
        },
        "round_index": {
          "type": "integer"
        },
        "seed": {
          "type": "integer"
        },
        "mode": {
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/memfolder.algorithm_state"
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      },
      "required": [
        "run_id",
        "snapshot"
      ]
    },
    "memfolder.snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "type": "string"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.memory_record"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.graph_edge"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.artifact_ref"
          }
        },
        "revision": {
          "type": "integer"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      },
      "required": [
        "snapshot_id",
        "records"
      ]
    },
    "memfolder.memory_record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/memfolder.scope"
        },
        "order": {
          "type": "integer"
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.origin"
          }
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.content_part"
          }
        },
        "kind": {
          "type": "string"
        },
        "eligible": {
          "type": "boolean"
        },
        "retention": {
          "$ref": "#/$defs/memfolder.retention"
        },
        "time_ranges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.time_range"
          }
        },
        "available_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/memfolder.time_point"
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/memfolder.time_point"
            },
            {
              "type": "null"
            }
          ]
        },
        "embeddings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.embedding"
          }
        },
        "native": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      },
      "required": [
        "node_id",
        "scope",
        "order",
        "origins"
      ]
    },
    "memfolder.scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "type": "string"
        },
        "sample_id": {
          "type": "string"
        },
        "partition_id": {
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "sample_id",
        "partition_id"
      ]
    },
    "memfolder.origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "$ref": "#/$defs/memfolder.scope"
        },
        "source_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "required": [
        "scope",
        "source_id"
      ]
    },
    "memfolder.content_part": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modality": {
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/memfolder.artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        "time_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/memfolder.time_range"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "modality"
      ]
    },
    "memfolder.artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "schema_id": {
          "type": "string"
        },
        "record_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "media_type"
      ]
    },
    "memfolder.time_range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "#/$defs/memfolder.time_point"
        },
        "end": {
          "$ref": "#/$defs/memfolder.time_point"
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "memfolder.time_point": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number"
        },
        "clock": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "clock"
      ]
    },
    "memfolder.retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "may_drop": {
          "type": "boolean"
        },
        "may_merge": {
          "type": "boolean"
        },
        "may_rewrite": {
          "type": "boolean"
        }
      },
      "required": []
    },
    "memfolder.embedding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "space": {
          "$ref": "#/$defs/memfolder.embedding_space"
        },
        "source_fingerprint": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/memfolder.artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "space",
        "source_fingerprint"
      ]
    },
    "memfolder.embedding_space": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "dimension": {
          "type": "integer"
        },
        "metric": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "revision",
        "dimension"
      ]
    },
    "memfolder.graph_edge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "relation": {
          "type": "string"
        },
        "weight": {
          "type": "number"
        },
        "directed": {
          "type": "boolean"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      },
      "required": [
        "edge_id",
        "source_id",
        "target_id",
        "relation"
      ]
    },
    "memfolder.resolved_budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request": {
          "$ref": "#/$defs/memfolder.budget_request"
        },
        "reference_fingerprint": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.budget_target"
          }
        }
      },
      "required": [
        "request",
        "reference_fingerprint",
        "targets"
      ]
    },
    "memfolder.budget_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "allocation": {
          "type": "string"
        },
        "rounding": {
          "type": "string"
        },
        "minimum": {
          "type": "integer"
        },
        "enforcement": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        },
        "measurement_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      },
      "required": [
        "unit"
      ]
    },
    "memfolder.budget_target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "group": {
          "$ref": "#/$defs/memfolder.budget_group"
        },
        "input_amount": {
          "type": "integer"
        },
        "limit": {
          "type": "integer"
        }
      },
      "required": [
        "group",
        "input_amount",
        "limit"
      ]
    },
    "memfolder.budget_group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "type": "string"
        },
        "member_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "group_id",
        "member_ids"
      ]
    },
    "memfolder.feature_batch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "input_fingerprint": {
          "type": "string"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.feature_row"
          }
        },
        "space": {
          "anyOf": [
            {
              "$ref": "#/$defs/memfolder.embedding_space"
            },
            {
              "type": "null"
            }
          ]
        },
        "vector_semantics": {
          "type": "string"
        },
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/memfolder.artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      },
      "required": [
        "name",
        "input_fingerprint",
        "rows"
      ]
    },
    "memfolder.feature_row": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "type": "string"
        },
        "vector": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "mass": {
          "type": "number"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      },
      "required": [
        "node_id"
      ]
    },
    "memfolder.algorithm_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "data": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.artifact_ref"
          }
        }
      },
      "required": [
        "schema",
        "version"
      ]
    },
    "JSONValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      ]
    }
  }
}
