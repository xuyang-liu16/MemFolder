{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Structural schema. Semantic invariants are enforced by memfolder.core.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "data"
  ],
  "properties": {
    "schema_id": {
      "const": "memfolder.sample_run_result"
    },
    "schema_version": {
      "const": 1
    },
    "data": {
      "$ref": "#/$defs/memfolder.sample_run_result"
    }
  },
  "$defs": {
    "memfolder.sample_run_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sample": {
          "$ref": "#/$defs/memfolder.sample_ref"
        },
        "source": {
          "$ref": "#/$defs/memfolder.artifact_ref"
        },
        "final": {
          "$ref": "#/$defs/memfolder.artifact_ref"
        },
        "materialized": {
          "$ref": "#/$defs/memfolder.artifact_ref"
        },
        "statistics": {
          "$ref": "#/$defs/memfolder.compression_statistics"
        },
        "evaluation": {
          "anyOf": [
            {
              "$ref": "#/$defs/memfolder.evaluation_report"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline_evaluation": {
          "anyOf": [
            {
              "$ref": "#/$defs/memfolder.evaluation_report"
            },
            {
              "type": "null"
            }
          ]
        },
        "timings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      },
      "required": [
        "sample",
        "source",
        "final",
        "materialized",
        "statistics"
      ]
    },
    "memfolder.sample_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "type": "string"
        },
        "sample_id": {
          "type": "string"
        },
        "split": {
          "type": "string"
        },
        "dataset_fingerprint": {
          "type": "string"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      },
      "required": [
        "dataset_id",
        "sample_id",
        "split",
        "dataset_fingerprint"
      ]
    },
    "memfolder.artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "schema_id": {
          "type": "string"
        },
        "record_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "media_type"
      ]
    },
    "memfolder.compression_statistics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_nodes": {
          "type": "integer"
        },
        "output_nodes": {
          "type": "integer"
        },
        "input_eligible": {
          "type": "integer"
        },
        "output_eligible": {
          "type": "integer"
        },
        "input_characters": {
          "type": "integer"
        },
        "output_characters": {
          "type": "integer"
        },
        "input_edges": {
          "type": "integer"
        },
        "output_edges": {
          "type": "integer"
        },
        "rounds": {
          "type": "integer"
        },
        "elapsed_seconds": {
          "type": "number"
        },
        "node_retention": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "character_retention": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "measurement": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      },
      "required": [
        "input_nodes",
        "output_nodes",
        "input_eligible",
        "output_eligible",
        "input_characters",
        "output_characters",
        "input_edges",
        "output_edges",
        "rounds",
        "elapsed_seconds",
        "node_retention",
        "character_retention"
      ]
    },
    "memfolder.evaluation_report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sample": {
          "$ref": "#/$defs/memfolder.sample_ref"
        },
        "protocol_id": {
          "type": "string"
        },
        "predictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.prediction"
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.metric_result"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.artifact_ref"
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      },
      "required": [
        "sample",
        "protocol_id",
        "predictions",
        "metrics"
      ]
    },
    "memfolder.prediction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "type": "string"
        },
        "sample": {
          "$ref": "#/$defs/memfolder.sample_ref"
        },
        "answer": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.content_part"
          }
        },
        "retrieval": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.retrieval_hit"
          }
        },
        "reader_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/memfolder.artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "usage": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      },
      "required": [
        "question_id",
        "sample",
        "answer"
      ]
    },
    "memfolder.content_part": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modality": {
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/memfolder.artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        "time_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/memfolder.time_range"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "modality"
      ]
    },
    "memfolder.time_range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "#/$defs/memfolder.time_point"
        },
        "end": {
          "$ref": "#/$defs/memfolder.time_point"
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "memfolder.time_point": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number"
        },
        "clock": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "clock"
      ]
    },
    "memfolder.retrieval_hit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "type": "string"
        },
        "rank": {
          "type": "integer"
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memfolder.origin"
          }
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "backend_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      },
      "required": [
        "node_id",
        "rank",
        "origins"
      ]
    },
    "memfolder.origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "$ref": "#/$defs/memfolder.scope"
        },
        "source_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "required": [
        "scope",
        "source_id"
      ]
    },
    "memfolder.scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "type": "string"
        },
        "sample_id": {
          "type": "string"
        },
        "partition_id": {
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "sample_id",
        "partition_id"
      ]
    },
    "memfolder.metric_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "question_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "details": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      },
      "required": [
        "name",
        "version",
        "value"
      ]
    },
    "JSONValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      ]
    }
  }
}
