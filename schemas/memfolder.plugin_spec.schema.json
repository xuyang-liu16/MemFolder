        },
        "api_version": {
          "type": "integer"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provides": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "action_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "execution_modes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diagnostic_schemas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      },
      "required": [
        "plugin_id",
        "role"
      ]
    },
    "JSONValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      ]
    }
  }
}
